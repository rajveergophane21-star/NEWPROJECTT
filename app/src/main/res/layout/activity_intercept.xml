<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/intercept_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/mark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pixel_logo"
            android:contentDescription="Margin" />

        <TextView
            android:id="@+id/eyebrow"
            style="@style/Label.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/dark_text"
            android:text="FOCUS" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Not now."
            android:textColor="@color/dark_text"
            android:textSize="34sp"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/appLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/panel_sh"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <!-- Friction-only breathing block -->
        <FrameLayout
            android:id="@+id/breathWrap"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <View
                android:id="@+id/breathOrb"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/circle"
                android:alpha="0.9" />

            <TextView
                android:id="@+id/breathCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/ink_on_accent"
                android:textSize="30sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/gold_hi"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/btnReplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:background="@drawable/btn_ghost"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="@drawable/btn_primary"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="18dp"
            android:paddingBottom="18dp"
            android:text="Take me back"
            android:textSize="16sp"
            android:textColor="@color/ink_on_accent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/gold_hi"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
