<?xml version="1.0" encoding="utf-8"?>
<!-- Raised terracotta bevel. Face darkened to sage_deep so white label text passes contrast. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#8A3D18"/></shape></item>
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/gold_hi"/></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/sage_deep"/></shape></item>
</layer-list>
