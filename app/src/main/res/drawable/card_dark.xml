<?xml version="1.0" encoding="utf-8"?>
<!-- Raised dark bevel — matches the hard-edged pixel kit (no rounded corners). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#1A130D"/></shape></item>
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle"><solid android:color="#3A2E22"/></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/dark_card"/></shape></item>
</layer-list>
