<?xml version="1.0" encoding="utf-8"?>
<!-- Warm peach beveled hero card — a focal colour block on the white canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#E8C49C"/></shape></item>
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFF1E1"/></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FAE7D1"/></shape></item>
</layer-list>
